# Local development with synthetic data. Set deployment secrets separately.
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://127.0.0.1:3000
# Optional comma-separated identities of reverse proxies that sanitize forwarding headers.
TRUSTED_PROXY_RANGES=
SESSION_TTL_HOURS=168
MAX_UPLOAD_BYTES=10485760
UPLOAD_RECOVERY_AGE_SECONDS=300

POSTGRES_PORT=55432
POSTGRES_USER=cloud_drive
POSTGRES_PASSWORD=cloud-drive-local-db
POSTGRES_DB=cloud_drive
DATABASE_URL=postgresql://cloud_drive:cloud-drive-local-db@127.0.0.1:55432/cloud_drive

MINIO_PORT=59000
S3_ENDPOINT=http://127.0.0.1:59000
S3_REGION=us-east-1
S3_BUCKET=cloud-drive-files
S3_ACCESS_KEY=cloud-drive-dev
S3_SECRET_KEY=cloud-drive-local-storage
